# Optional: enables AI itinerary drafting via OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for auth + cloud trip storage (Railway Postgres / any Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# API port (Vite proxies /api here in development)
PORT=8787

# Set to disable when using local Postgres without SSL
# PGSSLMODE=disable
